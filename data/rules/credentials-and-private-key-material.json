  "rules": [
    {
      "id": "credentials-and-private-key-material-openssh-id-path",
      "name": "OpenSSH ID Path",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/id_",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "openssh"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-522"
        ]
      },
      "tags": [
        "credential",
        "generic",
        "openssh",
        "private-key"
      ],
      "notes": "Generic SSH private-key filename prefix. Broad match intended to detect exposed private keys.",
