{
  "schema_version": 1,
  "category": {
    "id": "php-testing-and-diagnostic-artifacts",
    "name": "PHP Testing and Diagnostic Artifacts",
    "short_name": "PHP Testing and Diagnostic Artifacts",
    "description": "Detection rules for PHP Testing and Diagnostic Artifacts."
  },
  "rules": [
    {
      "id": "php-testing-and-diagnostic-artifacts-phpunit-vendor-phpunit-path",
      "name": "PHPUnit Path",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/vendor/phpunit",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "phpunit"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "php"
        ],
        "requires": []
      },
      "references": {
        "cves": [
          "CVE-2017-9841"
        ],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "php",
        "phpunit",
        "testing"
      ],
      "notes": "Exposed PHPUnit dependency directory frequently targeted for remote code execution.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
