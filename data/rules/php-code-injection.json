{
  "schema_version": 1,
  "category": {
    "id": "php-code-injection",
    "name": "PHP Code Injection",
    "short_name": "PHP Code Injection",
    "description": "Detection rules for PHP Code Injection."
  },
  "rules": [
    {
      "id": "php-code-injection-php-php-query",
      "name": "PHP <?php",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "<?php",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "php"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "php"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-94"
        ]
      },
      "tags": [
        "code-injection",
        "php"
      ],
      "notes": "Raw PHP opening tag indicating attempted PHP code injection.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
