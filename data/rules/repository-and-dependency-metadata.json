{
  "schema_version": 1,
  "category": {
    "id": "repository-and-dependency-metadata",
    "name": "Repository and Dependency Metadata",
    "short_name": "Repository and Dependency Metadata",
    "description": "Detection rules for Repository and Dependency Metadata."
  },
  "rules": [
    {
      "id": "repository-and-dependency-metadata-git-hidden-git-path",
      "name": "Git Hidden File",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/.git",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "low",
        "false_positive_risk": "medium"
      },
      "action": {
        "recommended": "log"
      },
      "applicability": {
        "platforms": [
          "git"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "dependency",
        "generic",
        "git",
        "metadata",
        "repository"
      ],
      "notes": "Git repository metadata and hidden files that may expose source code, commit history, or repository contents.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
