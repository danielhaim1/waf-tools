  "rules": [
    {
      "id": "backup-temporary-and-editor-files-bak-path",
      "name": "Backup File",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": ".bak",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "medium",
        "confidence": "low",
        "false_positive_risk": "medium"
      },
      "action": {
        "recommended": "log"
      },
      "applicability": {
        "platforms": [
          "generic"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": []
      },
      "tags": [
        "backup",
        "generic",
        "temporary-file"
      ],
