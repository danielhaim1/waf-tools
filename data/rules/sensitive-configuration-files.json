{
  "schema_version": 1,
  "category": {
    "id": "sensitive-configuration-files",
    "name": "Sensitive Configuration Files",
    "short_name": "Sensitive Configuration Files",
    "description": "Detection rules for Sensitive Configuration Files."
  },
  "rules": [
    {
      "id": "sensitive-configuration-files-wordpress-wp-config-path",
      "name": "WordPress Config Path",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/wp-config",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "wordpress"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "wordpress"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "configuration",
        "sensitive-file",
        "wordpress"
      ],
      "notes": "WordPress configuration file family, including backup and temporary variants.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
