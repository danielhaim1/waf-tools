{
  "schema_version": 1,
  "category": {
    "id": "crlf-injection",
    "name": "CRLF Injection",
    "short_name": "CRLF Injection",
    "description": "Detection rules for CRLF Injection."
  },
  "rules": [
    {
      "id": "crlf-carriage-return-line-feed",
      "name": "CRLF Sequence",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "%0d%0a",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "generic-http"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-113"
        ]
      },
      "tags": [
        "crlf",
        "encoded",
        "generic",
        "generic-http",
        "http-response-splitting"
      ],
      "notes": "URL-encoded CRLF (`\\r\\n`) sequence used in header injection attacks.",
