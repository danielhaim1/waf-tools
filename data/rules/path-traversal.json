  "rules": [
    {
      "id": "path-traversal-parent-directory",
      "name": "Parent Directory Traversal",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "../",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "generic"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-22"
        ]
      },
      "tags": [
        "generic",
        "path-traversal"
      ],
      "notes": "Plain-text parent-directory traversal sequence.",
