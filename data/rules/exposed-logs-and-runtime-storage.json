{
  "schema_version": 1,
  "category": {
    "id": "exposed-logs-and-runtime-storage",
    "name": "Exposed Logs and Runtime Storage",
    "short_name": "Exposed Logs and Runtime Storage",
    "description": "Detection rules for Exposed Logs and Runtime Storage."
  },
  "rules": [
    {
      "id": "exposed-logs-and-runtime-storage-laravel-storage-logs-path",
      "name": "Laravel Logs Directory",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/storage/logs/",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "laravel"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "laravel"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "laravel",
        "logs",
        "runtime"
      ],
      "notes": "Laravel or application log directory that may expose stack traces, credentials, or sensitive application data.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
