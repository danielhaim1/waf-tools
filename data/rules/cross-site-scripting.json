    {
      "id": "xss-script-opening-tag",
      "name": "Script Opening Tag",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "<script",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "generic"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-79"
        ]
      },
      "tags": [
        "generic",
        "xss"
      ],
      "notes": "HTML `<script>` tag injection.",
