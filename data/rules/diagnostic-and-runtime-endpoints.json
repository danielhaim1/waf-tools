  "rules": [
    {
      "id": "diagnostic-and-runtime-endpoints-apache-server-status-path",
      "name": "Apache Server Status Path",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/server-status",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "apache-http-server"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "apache"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": []
      },
      "tags": [
        "apache",
        "apache-http-server",
        "diagnostic-endpoint",
        "runtime"
      ],
      "notes": "Apache `mod_status` endpoint exposing active requests, worker status, and server statistics.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
