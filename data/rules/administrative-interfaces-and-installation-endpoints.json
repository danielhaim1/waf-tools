  },
  "rules": [
    {
      "id": "admin-wordpress-xmlrpc",
      "name": "WordPress XML-RPC Endpoint",
      "detection": {
        "location": "path",
        "match": "exact",
        "pattern": "/xmlrpc.php",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "eq"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "wordpress"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "wordpress"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "admin-endpoint",
        "wordpress"
      ],
      "notes": "WordPress XML-RPC endpoint frequently targeted for brute-force, pingback abuse, and amplification attacks.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
