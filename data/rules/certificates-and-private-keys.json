{
  "schema_version": 1,
  "category": {
    "id": "certificates-and-private-keys",
    "name": "Certificates and Private Keys",
    "short_name": "Certificates and Private Keys",
    "description": "Detection rules for Certificates and Private Keys."
  },
  "rules": [
    {
      "id": "certificates-and-private-keys-x-509-pem-path",
      "name": "X.509 PEM File",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": ".pem",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "openssl",
          "x509"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "certificate",
        "generic",
        "openssl",
        "private-key",
        "x509"
      ],
      "notes": "PEM-encoded certificate, private key, or certificate chain. May expose cryptographic material.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
    {
