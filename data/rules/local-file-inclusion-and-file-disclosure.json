{
  "schema_version": 1,
  "category": {
    "id": "local-file-inclusion-and-file-disclosure",
    "name": "Local File Inclusion and File Disclosure",
    "short_name": "Local File Inclusion and File Disclosure",
    "description": "Detection rules for Local File Inclusion and File Disclosure."
  },
  "rules": [
    {
      "id": "local-file-inclusion-and-file-disclosure-linux-etc-passwd-query",
      "name": "Linux Passwd Path",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "/etc/passwd",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "linux",
          "unix"
        ],
        "operating_systems": [
          "linux"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-98"
        ]
      },
      "tags": [
        "file-disclosure",
        "generic",
        "linux",
        "local-file-inclusion",
        "unix"
      ],
      "notes": "Unix password database file commonly targeted during local file inclusion and arbitrary file read attacks.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
