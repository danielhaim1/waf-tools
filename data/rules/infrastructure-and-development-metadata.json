    {
      "id": "infrastructure-and-development-metadata-terraform-terraform-path",
      "name": "Terraform Path",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/terraform",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "medium",
        "confidence": "low",
        "false_positive_risk": "medium"
      },
      "action": {
        "recommended": "log"
      },
      "applicability": {
        "platforms": [
          "terraform"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
