{
  "schema_version": 1,
  "category": {
    "id": "database-and-configuration-artifacts",
    "name": "Database and Configuration Artifacts",
    "short_name": "Database and Configuration Artifacts",
    "description": "Detection rules for Database and Configuration Artifacts."
  },
  "rules": [
    {
      "id": "database-and-configuration-artifacts-sql-databases-sql-path",
      "name": "SQL File",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": ".sql",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "low",
        "false_positive_risk": "medium"
      },
      "action": {
        "recommended": "log"
      },
      "applicability": {
        "platforms": [
          "sql-databases"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-200"
        ]
      },
      "tags": [
        "configuration",
        "file",
        "generic",
        "sql-databases"
      ],
      "notes": "SQL database dump or script that may expose application data, schema, or credentials.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
