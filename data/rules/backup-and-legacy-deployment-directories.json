{
  "schema_version": 1,
  "category": {
    "id": "backup-and-legacy-deployment-directories",
    "name": "Backup and Legacy Deployment Directories",
    "short_name": "Backup and Legacy Deployment Directories",
    "description": "Detection rules for Backup and Legacy Deployment Directories."
  },
  "rules": [
    {
      "id": "backup-and-legacy-deployment-directories-backup-path",
      "name": "Backup Directory",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": "/backup/",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "medium",
        "false_positive_risk": "medium"
      },
      "action": {
        "recommended": "log"
      },
      "applicability": {
        "platforms": [
          "generic"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": []
      },
      "tags": [
        "backup",
        "generic",
        "sensitive-path"
      ],
      "notes": "Generic backup directory that may expose archived application files or source code.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
