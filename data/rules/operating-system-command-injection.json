{
  "schema_version": 1,
  "category": {
    "id": "operating-system-command-injection",
    "name": "Operating-System Command Injection",
    "short_name": "Operating-System Command Injection",
    "description": "Detection rules for Operating-System Command Injection."
  },
  "rules": [
    {
      "id": "operating-system-command-injection-windows-cmd-exe-query",
      "name": "Windows Cmd.exe",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "cmd.exe",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "critical",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "microsoft-windows"
        ],
        "operating_systems": [
          "windows"
        ],
        "web_stacks": [
          "generic"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-78"
        ]
      },
      "tags": [
        "command-injection",
        "generic",
        "microsoft-windows",
        "rce"
      ],
      "notes": "Windows command interpreter commonly targeted in operating-system command injection attacks.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
