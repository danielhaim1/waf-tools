  },
  "rules": [
    {
      "id": "stream-file-wrapper",
      "name": "PHP File Wrapper",
      "detection": {
        "location": "query",
        "match": "contains",
        "pattern": "file://",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.query",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "high",
        "confidence": "high",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "generic",
          "php"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "php"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": [
          "CWE-94",
          "CWE-98"
        ]
      },
      "tags": [
        "file-inclusion",
        "generic",
        "php"
      ],
      "notes": "Local file URI wrapper commonly used in Local File Inclusion (LFI) and arbitrary file read attacks.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
