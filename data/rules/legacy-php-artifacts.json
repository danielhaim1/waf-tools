{
  "schema_version": 1,
  "category": {
    "id": "legacy-php-artifacts",
    "name": "Legacy PHP Artifacts",
    "short_name": "Legacy PHP Artifacts",
    "description": "Detection rules for Legacy PHP Artifacts."
  },
  "rules": [
    {
      "id": "legacy-php-artifacts-php-phtml-path",
      "name": "PHP PHTML File",
      "detection": {
        "location": "path",
        "match": "contains",
        "pattern": ".phtml",
        "case_sensitive": true,
        "decoding": {
          "url_decode": false,
          "html_entity_decode": false
        }
      },
      "implementations": {
        "cloudflare": {
          "field": "http.request.uri.path",
          "operator": "contains"
        }
      },
      "risk": {
        "severity": "medium",
        "confidence": "medium",
        "false_positive_risk": "low"
      },
      "action": {
        "recommended": "block"
      },
      "applicability": {
        "platforms": [
          "php"
        ],
        "operating_systems": [
          "any"
        ],
        "web_stacks": [
          "php"
        ],
        "requires": []
      },
      "references": {
        "cves": [],
        "cwes": []
      },
      "tags": [
        "php"
      ],
      "notes": "Legacy PHP file extension commonly targeted during reconnaissance and exploitation.",
      "ui": {
        "default_selected": false,
        "recommended": false
      }
    },
